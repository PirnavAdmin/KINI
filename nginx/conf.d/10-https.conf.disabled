server {
    listen 443 ssl http2;
    server_name kiniedx.com;

    ssl_certificate /etc/letsencrypt/live/www.kiniedx.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.kiniedx.com/privkey.pem;

    return 301 https://www.kiniedx.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.kiniedx.com;

    ssl_certificate /etc/letsencrypt/live/www.kiniedx.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.kiniedx.com/privkey.pem;

    client_max_body_size 20m;

    location /api/api/ {
        rewrite ^/api/api/(.*)$ /api/$1 break;
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cache-Control "no-cache";
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    }
}
